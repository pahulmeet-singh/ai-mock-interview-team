# All optional in development: the Vite proxy forwards /api to the Express server.

# Where the API lives. Leave unset in development. In production, point this at your deployed API,
# e.g. https://mockroom-api.onrender.com/api  (then set COOKIE_SAMESITE=none on the server).
# VITE_API_URL=

# Used by the dev/preview proxy only.
# VITE_PROXY_TARGET=http://localhost:5000

# All times are shown in this time zone. Keep it equal to SLOT_TZ in server/.env.
VITE_APP_TIMEZONE=Asia/Kolkata
