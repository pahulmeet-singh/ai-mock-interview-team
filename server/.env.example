# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when the API runs behind a proxy / load balancer (Render, Railway, Heroku ...)
TRUST_PROXY=0

# ── Supabase (server only: never expose this key to the browser) ──
# Project URL: Supabase dashboard → project Overview (or the Connect button).
SUPABASE_URL=
# The project's SECRET key (starts with sb_secret_): dashboard → Settings → API Keys.
# Older projects call it the service_role key, and that works too.
SUPABASE_SERVICE_ROLE_KEY=
# Private storage bucket for resumes. The server creates it on boot if it is missing.
SUPABASE_RESUME_BUCKET=resumes

# ── Auth ──────────────────────────────────────────────────────────────────
# 32+ random characters, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# "lax" is right when the browser talks to the API through the Vite proxy or the same domain.
# Use "none" only for a cross-site deployment (requires HTTPS).
COOKIE_SAMESITE=lax

# ── Gemini (server only) ──────────────────────────────────────────────────
GEMINI_API_KEY=
# Free-tier friendly default. Switch to gemini-3.8-flash for stronger feedback (much lower free quota).
GEMINI_MODEL=gemini-3.5-flash-lite
# interactions = Google's recommended API.  generateContent = long-standing fallback if you hit a 400/404.
GEMINI_API=interactions
# true = deterministic offline fixtures (no key, no network). Good for demos, tests and quota trouble.
GEMINI_MOCK=false

# ── Slots and sessions ────────────────────────────────────────────────────
# Keep VITE_APP_TIMEZONE in client/.env equal to SLOT_TZ.
SLOT_TZ=Asia/Kolkata
SLOT_START_HOUR=10
SLOT_END_HOUR=18
SLOT_MINUTES=60
SLOT_DAYS_AHEAD=14
SLOT_LEAD_MINUTES=30
# false = a booked session can be started any time (handy for demos).
# true  = starts 10 minutes before the slot and closes 30 minutes after it begins.
SLOT_ENFORCE_WINDOW=false
SESSION_MINUTES=45
QUESTIONS_PER_SESSION=5
